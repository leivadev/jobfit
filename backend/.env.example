R2_BUCKET_NAME=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=

HF_TOKEN=

# Comma-separated list of origins allowed to call the API (CORS).
# Defaults to http://localhost:5173,http://127.0.0.1:5173 (Vite dev server,
# both hostnames it may be reached on) if unset.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate-limit client key: remote_address (default) or forwarded_for.
# Set forwarded_for behind an ingress proxy, else all visitors share one IP.
# RATE_LIMIT_KEY_STRATEGY=forwarded_for
