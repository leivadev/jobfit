{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jobfit-app",
  "compatibility_date": "2026-09-04",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
	"routes": [
		{
			"pattern": "jobfit-app.leivadev.com",
			"custom_domain": true
		}
	],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  },
}